{
  "name": "zakat-mal",
  "version": "1.0.0",
  "description": "Authoritative, mathematically rigorous, and Fiqh-verified Zakat Mal calculation engine. Grounded in Al-Qur'an, Sahih Hadith, AAOIFI Shari'ah Standard No. 35, and Fatwa MUI/BAZNAS.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./gold-silver": {
      "types": "./dist/modules/gold-silver.d.ts",
      "import": "./dist/modules/gold-silver.mjs",
      "require": "./dist/modules/gold-silver.js"
    },
    "./cash-savings": {
      "types": "./dist/modules/cash-savings.d.ts",
      "import": "./dist/modules/cash-savings.mjs",
      "require": "./dist/modules/cash-savings.js"
    },
    "./business": {
      "types": "./dist/modules/business.d.ts",
      "import": "./dist/modules/business.mjs",
      "require": "./dist/modules/business.js"
    },
    "./income": {
      "types": "./dist/modules/income.d.ts",
      "import": "./dist/modules/income.mjs",
      "require": "./dist/modules/income.js"
    },
    "./agriculture": {
      "types": "./dist/modules/agriculture.d.ts",
      "import": "./dist/modules/agriculture.mjs",
      "require": "./dist/modules/agriculture.js"
    },
    "./livestock": {
      "types": "./dist/modules/livestock.d.ts",
      "import": "./dist/modules/livestock.mjs",
      "require": "./dist/modules/livestock.js"
    },
    "./rikaz-mining": {
      "types": "./dist/modules/rikaz-mining.d.ts",
      "import": "./dist/modules/rikaz-mining.mjs",
      "require": "./dist/modules/rikaz-mining.js"
    },
    "./investments": {
      "types": "./dist/modules/investments.d.ts",
      "import": "./dist/modules/investments.mjs",
      "require": "./dist/modules/investments.js"
    },
    "./corporate": {
      "types": "./dist/modules/corporate.d.ts",
      "import": "./dist/modules/corporate.mjs",
      "require": "./dist/modules/corporate.js"
    },
    "./rental-yield": {
      "types": "./dist/modules/rental-yield.d.ts",
      "import": "./dist/modules/rental-yield.mjs",
      "require": "./dist/modules/rental-yield.js"
    },
    "./dalil": {
      "types": "./dist/dalil/index.d.ts",
      "import": "./dist/dalil/index.mjs",
      "require": "./dist/dalil/index.js"
    }
  },
  "bin": {
    "zakat-mal": "./bin/zakat-mal.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node scripts/e2e-validator.mjs",
    "validate": "npm run prepublishOnly && node scripts/e2e-validator.mjs",
    "demo": "node scripts/demo.mjs",
    "prepublishOnly": "npm run test && npm run build"
  },
  "keywords": [
    "zakat",
    "zakat-mal",
    "islamic-finance",
    "fiqh",
    "nisab",
    "hawl",
    "aaoifi",
    "shariah",
    "sharia",
    "gold-zakat",
    "crypto-zakat",
    "corporate-zakat",
    "agriculture-zakat",
    "livestock-zakat",
    "baznas",
    "fatwa-mui",
    "hadith",
    "quran",
    "fintech"
  ],
  "author": "Khairan Noor <khairking6@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/codesbykhairannoor/zakat-mal.git"
  },
  "bugs": {
    "url": "https://github.com/codesbykhairannoor/zakat-mal/issues"
  },
  "homepage": "https://github.com/codesbykhairannoor/zakat-mal#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
